# Copy to .env.production and fill in real values. Loaded by the
# systemd unit (deploy/solar-sim.service) via EnvironmentFile.
# Never commit the filled-in .env.production — it's gitignored.

# Absolute path to the SQLite cohort database. Use a stable location
# inside the app's WorkingDirectory; the systemd User must be able to
# read and write to it.
SOLAR_SIM_DB=/home/victor/apps/solar-sim/solar-sim.db

# Shared secret that gates instructor self-registration. Pick a value
# only you (and any co-instructors) know. With this set, students
# cannot accidentally register as instructors, and the dev-mode
# default-admin seed (admin@solar-sim.local / tester) is NOT created.
SOLAR_SIM_INSTRUCTOR_TOKEN=change-me-to-a-long-random-string

# Public URL students will visit. Pre-fills the "Onboarding
# instructions for students" copy-paste block on the Teams & members
# tab so you don't have to edit it by hand.
SOLAR_SIM_PUBLIC_URL=https://solar-sim.example.com
